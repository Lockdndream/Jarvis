# Jarvis environment configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# LLM provider for the conversational supervisor
# JARVIS_LLM_PROVIDER: which provider adapter to use; default openai
JARVIS_LLM_PROVIDER=openrouter
# JARVIS_LLM_BASE_URL: provider API endpoint; default https://api.openai.com/v1
JARVIS_LLM_BASE_URL=https://openrouter.ai/api/v1
# JARVIS_LLM_MODEL: model identifier sent to the provider; default gpt-4o-mini
JARVIS_LLM_MODEL=openrouter/free
# JARVIS_LLM_FREE_ONLY: when true, filter OpenRouter routes to free models only; default false
JARVIS_LLM_FREE_ONLY=true
# JARVIS_LLM_API_KEY: provider API key; default empty
JARVIS_LLM_API_KEY=

# Supervisor
# JARVIS_SUPERVISOR_ENABLED: enable the conversational supervisor; default 1
JARVIS_SUPERVISOR_ENABLED=1
# JARVIS_TEST_MODE: set to 1 to enable test-only behavior; default unset
# JARVIS_TEST_MODE=

# OpenCode integration
# JARVIS_OPCODE_BIN: legacy/deprecated path hint (not read by current code)
# JARVIS_OPCODE_PORT: legacy/deprecated port hint (not read by current code)
# JARVIS_OPENCODE_EXE: path to the opencode executable; default C:\Users\Admin\.bun\bin\opencode.exe
# JARVIS_OPENCODE_EXE=
# JARVIS_OPENCODE_PORT: port for the managed OpenCode server; default 4097
JARVIS_OPENCODE_PORT=4097
# JARVIS_OPENCODE_OWNER_MARKER: path to the ownership marker file; default .jarvis_opencode_owner.json in repo root
# JARVIS_OPENCODE_OWNER_MARKER=
# JARVIS_OPENCODE_RUNTIME_DIR: isolated OpenCode runtime directory; default %LOCALAPPDATA%\JarvisOpenCodeRuntime
# JARVIS_OPENCODE_RUNTIME_DIR=
# JARVIS_OPENCODE_OPENROUTER_KEY: OpenRouter key used to provision isolated OpenCode auth; falls back to JARVIS_LLM_API_KEY
# JARVIS_OPENCODE_OPENROUTER_KEY=
# OPENCODE_SERVER_USERNAME: HTTP Basic auth username for opencode serve; default opencode
OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD: HTTP Basic auth password for opencode serve; default empty
OPENCODE_SERVER_PASSWORD=
# JARVIS_OPENCODE_MODEL_PROVIDER_ID: provider id for OpenCode delegation; default openrouter
JARVIS_OPENCODE_MODEL_PROVIDER_ID=openrouter
# JARVIS_OPENCODE_ALLOW_PAID: allow paid models in OpenCode delegation; default false
# JARVIS_OPENCODE_ALLOW_PAID=false
# JARVIS_OPENCODE_MODEL_ID: specific paid model id for OpenCode delegation; default unset
# JARVIS_OPENCODE_MODEL_ID=
# JARVIS_OPENCODE_CREDIT_THRESHOLD_USD: minimum OpenRouter credit balance before paid delegation; default unset
# JARVIS_OPENCODE_CREDIT_THRESHOLD_USD=

# WebSocket tokens (ADR-014)
# JARVIS_WS_TOKEN_SECRET: HS256 signing secret; auto-generated per process if unset
# JARVIS_WS_TOKEN_SECRET=
# JARVIS_WS_TOKEN_TTL_SECONDS: token lifetime in seconds; default 900
JARVIS_WS_TOKEN_TTL_SECONDS=900

# Web Push (VAPID)
# JARVIS_VAPID_PUBLIC_KEY: VAPID public key exposed to browsers; default unset
# JARVIS_VAPID_PUBLIC_KEY=
# JARVIS_VAPID_PRIVATE_KEY: VAPID private key — secret, never commit; default unset
# JARVIS_VAPID_PRIVATE_KEY=
# JARVIS_VAPID_SUBJECT: VAPID subject claim, usually mailto:; default mailto:admin@localhost
JARVIS_VAPID_SUBJECT=mailto:admin@localhost

# Operations console
# JARVIS_OPERATIONS_TARGET_URL: Jarvis HTTPS endpoint the console controls; default https://127.0.0.1:8443
JARVIS_OPERATIONS_TARGET_URL=https://127.0.0.1:8443
# JARVIS_OPERATIONS_PORT: port the operations console HTTP server binds to; default 8500
JARVIS_OPERATIONS_PORT=8500
# JARVIS_OPERATIONS_VERIFY_TLS: verify TLS when the console talks to Jarvis; default false
JARVIS_OPERATIONS_VERIFY_TLS=false
# JARVIS_OPERATIONS_CWD: working directory for the managed Jarvis process; default repo root
# JARVIS_OPERATIONS_CWD=
# JARVIS_OPERATIONS_JARVIS_OWNER_MARKER: path to the Jarvis ownership marker file; default .jarvis_operations_jarvis_owner.json in repo root
# JARVIS_OPERATIONS_JARVIS_OWNER_MARKER=
# JARVIS_OPERATIONS_DB: SQLite path for operation history; default %LOCALAPPDATA%\JarvisOperationsConsole\operations.db
# JARVIS_OPERATIONS_DB=
# JARVIS_SSL_KEYFILE: TLS key file for HTTPS; default unset
# JARVIS_SSL_KEYFILE=
# JARVIS_SSL_CERTFILE: TLS certificate file for HTTPS; default unset
# JARVIS_SSL_CERTFILE=
# JARVIS_BIND_HOST: host the main Jarvis server binds to; default 0.0.0.0
JARVIS_BIND_HOST=0.0.0.0
# JARVIS_VENV_PYTHON: Python executable used to spawn Jarvis; default python
JARVIS_VENV_PYTHON=python

# API authentication
# JARVIS_API_TOKEN: bearer token required by protected HTTP endpoints; default unset (unprotected)
# JARVIS_API_TOKEN=

# Logging
# JARVIS_LOG_DIR: directory for rotated log files; default logs
JARVIS_LOG_DIR=logs
# JARVIS_LOG_LEVEL: logging level; default INFO
JARVIS_LOG_LEVEL=INFO
# JARVIS_LOG_RETENTION_DAYS: number of days to retain log files; default 14
JARVIS_LOG_RETENTION_DAYS=14

# Attention / interruption policy
# JARVIS_NOTIFY_ON_COMPLETION: notify when tasks complete; default true
JARVIS_NOTIFY_ON_COMPLETION=true
# JARVIS_DEFAULT_SNOOZE_MINUTES: fallback snooze duration for vague deferrals; default unset (asks for clarification)
# JARVIS_DEFAULT_SNOOZE_MINUTES=
# JARVIS_ATTENTION_RETRY_MINUTES: retry interval after SILENT/DEFER decisions; default 30
JARVIS_ATTENTION_RETRY_MINUTES=30
# JARVIS_QUIET_HOURS: local-time quiet-hours window "HH:MM-HH:MM"; default unset (disabled)
# JARVIS_QUIET_HOURS=22:00-07:00

# Safe project aliases for the supervisor
# JARVIS_PROJECTS_FILE: JSON file mapping aliases to project paths; default projects.json in repo root
# JARVIS_PROJECTS_FILE=

# OS-provided paths (normally set by Windows; listed for documentation only)
# LOCALAPPDATA: Windows per-user application data directory
# LOCALAPPDATA=
# TEMP: Windows temporary directory
# TEMP=
